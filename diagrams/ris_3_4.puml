@startuml
skinparam componentStyle uml2
skinparam shadowing false

package "React Frontend" {
  [React UI Components] as UI
  [API Client (Axios/Fetch)] as ApiClient
}

package "Node.js Express Backend" {
  [Express Router] as Router
  [Auth Middleware] as AuthMid
  [Controllers] as Controllers
  [Services (Logic)] as Services
  [Sequelize ORM] as ORM
}

database "PostgreSQL Database" as DB

UI --> ApiClient : Виклики API (React hooks)
ApiClient --> Router : HTTP REST API Requests (JWT)
Router --> AuthMid : Аутентифікація запитів
AuthMid --> Controllers : Маршрутизація до обробників
Controllers --> Services : Бізнес-логіка додатку
Services --> ORM : Звернення до моделей
ORM --> DB : SQL Запити (DDL/DML)
@enduml
