@startuml
skinparam ActivityStyle rectangle
skinparam shadowing false

start
:Запуск веб-застосунку;
:Перевірка наявності JWT токена в LocalStorage;
if (Токен існує?) then (так)
  :Завантаження списку підписок та категорій;
else (ні)
  repeat
    :Відобразити форму входу (Email, Пароль);
    :Користувач вводить облікові дані;
    :Надіслати POST-запит на сервер (/api/auth/login);
    :Сервер виконує автентифікацію;
  backward:Відобразити повідомлення про помилку входу;
  repeat while (Автентифікація успішна?) is (ні) not (так)
  :Зберегти отриманий JWT токен у LocalStorage;
  :Завантаження даних користувача;
endif

:Перехід на Головну сторінку (Дашборд);
:Відображення віджетів та графіків Recharts;

if (Користувач ініціює створення підписки?) then (так)
  :Відкрити модальне вікно додавання підписки;
  :Користувач заповнює поля форми;
  :Надіслати POST-запит на сервер (/api/subscriptions);
  if (Валідація полів на сервері успішна?) then (так)
    :Зберегти запис підписки у базі даних PostgreSQL;
    :Повернути клієнту статус 201 та дані запису;
    :Оновити стан інтерфейсу (додати у список);
    :Перерахувати загальну статистику витрат;
  else (ні)
    :Повернути статус 400 Bad Request;
    :Відобразити помилки валідації на формі;
  endif
else (ні)
endif

stop
@enduml
