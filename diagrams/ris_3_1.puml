@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Користувач" as User
actor "Адміністратор" as Admin

rectangle "SubTracker (Застосунок для обліку підписок)" {
  usecase "Реєстрація в системі" as UC_Register
  usecase "Авторизація (Вхід)" as UC_Login
  usecase "Додавання підписки" as UC_AddSub
  usecase "Редагування підписки" as UC_EditSub
  usecase "Видалення підписки" as UC_DeleteSub
  usecase "Архівування підписки" as UC_ArchiveSub
  usecase "Перегляд статистики та аналітики" as UC_Stats
  usecase "Керування налаштуваннями профілю" as UC_Profile
  
  usecase "Керування користувачами" as UC_ManageUsers
  usecase "Перегляд системної статистики" as UC_SysStats
  usecase "Керування категоріями підписок" as UC_ManageCats
}

User --> UC_Register
User --> UC_Login
User --> UC_AddSub
User --> UC_EditSub
User --> UC_DeleteSub
User --> UC_ArchiveSub
User --> UC_Stats
User --> UC_Profile

Admin --> UC_ManageUsers
Admin --> UC_SysStats
Admin --> UC_ManageCats
@enduml
