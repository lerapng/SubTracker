@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "Ітерація 1 (Ядро системи та MVP)" #AliceBlue {
  [Планування та аналіз вимог] as P1
  [Проєктування БД та архітектури] as D1
  [Розробка базового API та UI] as Dev1
  [Тестування базових функцій] as T1
  [Оцінка результатів та планування наступної фази] as E1

  P1 -down-> D1
  D1 -down-> Dev1
  Dev1 -down-> T1
  T1 -down-> E1
}

package "Ітерація 2 (Безпека та мультивалютність)" #HoneyDew {
  [Планування та розширення вимог] as P2
  [Проєктування JWT та інтеграції API курсів] as D2
  [Реалізація Auth та сервісу конвертації] as Dev2
  [Тестування безпеки та валютних розрахунків] as T2
  [Оцінка та аналіз відгуків] as E2

  P2 -down-> D2
  D2 -down-> Dev2
  Dev2 -down-> T2
  T2 -down-> E2
}

package "Ітерація 3 (Інтерактивна аналітика та Clearbit API)" #Lavender {
  [Планування візуалізації та автоматизації] as P3
  [Проєктування графіків Recharts та інтеграції Clearbit] as D3
  [Розробка аналітики та автозаповнення логотипів] as Dev3
  [Фінальне інтеграційне тестування] as T3
  [Реліз стабільної версії системи] as E3

  P3 -down-> D3
  D3 -down-> Dev3
  Dev3 -down-> T3
  T3 -down-> E3
}

E1 -right-> P2 : "Базова версія (MVP)"
E2 -right-> P3 : "Проміжний реліз"
E3 -right-> [Готовий програмний продукт (Реліз)] : "Фінальне розгортання"
@enduml
